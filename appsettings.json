{
  "Hangfire": {
    "WorkerEnabled": true
  },
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-6-astra",
    "TimeoutSeconds": 20,
    "MaxCallsPerDay": 1000
  },
  "Import": {
    "MaxUploadBytes": 5242880,
    "RawFileRetention": {
      "Enabled": false,
      "Days": 90
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
