@if (TotalPages > 1)
{
    <div class="pager">
        <button type="button" class="secondary" disabled="@(Disabled || Page <= 1)" @onclick="() => OnPageChanged.InvokeAsync(Page - 1)">Previous</button>
        <span>Page @Page of @TotalPages</span>
        <button type="button" class="secondary" disabled="@(Disabled || Page >= TotalPages)" @onclick="() => OnPageChanged.InvokeAsync(Page + 1)">Next</button>
    </div>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
}
