@* wwwroot/theme.js handles the click, so this works on static and interactive pages alike. *@
<button type="button" class="secondary theme-toggle" data-theme-toggle title="Switch between light and night mode">
    <span class="when-light">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
        <span class="visually-hidden">Switch to night mode</span>
    </span>
    <span class="when-dark">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <span class="visually-hidden">Switch to light mode</span>
    </span>
</button>
