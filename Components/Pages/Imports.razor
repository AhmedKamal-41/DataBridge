@page "/imports"
@attribute [Authorize(Roles = AppRoles.ImportReviewers)]
@inject DataBridgeApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Imports</PageTitle>

<section class="page-heading">
    <div><p class="eyebrow">Workspace</p><h1>Imports</h1><p>Upload spreadsheets and review each batch before committing changes.</p></div>
</section>

<AuthorizeView Roles="@AppRoles.ImportManagers">
<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Upload a file</h2>
            <p class="muted">@(context.User.IsInRole(AppRoles.Guest) ? $"Guest limit of 1 MB and {GuestWorkspace.MaxRowsPerImport} data rows per file." : "Start a new batch from a CSV or Excel workbook.")</p>
        </div>
    </div>

    @if (uploadError != null)
    {
        <div class="notice error" role="alert">@uploadError</div>
    }

    <label class="upload-dropzone">
        <span class="upload-symbol" aria-hidden="true">↑</span>
        <strong>@(selectedFile?.Name ?? "Choose a CSV or Excel file")</strong>
        <span class="muted">Select a file or drop it here · .csv or .xlsx</span>
        <InputFile class="upload-input" OnChange="SelectFile" accept=".csv,.xlsx" aria-label="CSV or Excel file" />
    </label>
    <div class="actions upload-actions">
        <button type="button" disabled="@(selectedFile == null || isUploading)" @onclick="UploadAsync">
            @(isUploading ? "Uploading..." : "Upload")
        </button>
    </div>
</section>
</AuthorizeView>

<section class="panel">
    <div class="panel-heading"><div><h2>Import history</h2><p class="muted">Track validation, reviews, and completed batches.</p></div></div>

    @if (errorMessage != null)
    {
        <div class="notice error" role="alert">@errorMessage</div>
        <button type="button" class="secondary" @onclick="() => LoadBatchesAsync(page)">Try again</button>
    }
    else if (batches == null)
    {
        <p class="muted" role="status">Loading batches...</p>
    }
    else if (batches.Items.Count == 0)
    {
        <div class="empty-state"><strong>No files have been uploaded yet.</strong><p>New batches will appear here after upload.</p></div>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr><th>ID</th><th>File</th><th>Status</th><th>Job</th><th>Rows</th></tr>
                </thead>
                <tbody>
                    @foreach (ImportBatchDto batch in batches.Items)
                    {
                        <tr>
                            <td>@batch.Id</td>
                            <td><a href="imports/@batch.Id">@batch.FileName</a></td>
                            <td><span class="badge @(batch.Status == "Committed" ? "good" : "")">@batch.Status</span></td>
                            <td>@batch.Job.Stage</td>
                            <td>@batch.RowCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="batches.Page" TotalPages="batches.TotalPages" OnPageChanged="LoadBatchesAsync" />
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private const int PageSize = 25;

    // Only the most this page will read from the browser. The configured upload
    // limit is enforced by ImportService, which returns its own clear error.
    private const long MaxBrowserFileBytes = 29_000_000;

    private PagedResponse<ImportBatchDto>? batches;
    private int page = 1;
    private string? errorMessage;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string? uploadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadBatchesAsync(1);
    }

    private async Task LoadBatchesAsync(int newPage)
    {
        page = newPage;
        errorMessage = null;

        try
        {
            batches = await ApiClient.GetBatchesAsync(page, PageSize);
        }
        catch (ApiException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        uploadError = null;
    }

    private async Task UploadAsync()
    {
        if (selectedFile == null)
        {
            return;
        }

        bool isGuest = (await AuthenticationState).User.IsInRole(AppRoles.Guest);
        long fileLimit = isGuest ? GuestWorkspace.MaxFileBytes : MaxBrowserFileBytes;
        if (selectedFile.Size > fileLimit)
        {
            uploadError = $"{selectedFile.Name} is too large to upload.";
            return;
        }

        isUploading = true;
        uploadError = null;

        try
        {
            await using Stream fileStream = selectedFile.OpenReadStream(fileLimit);
            ImportAcceptedDto accepted = await ApiClient.UploadAsync(selectedFile.Name, fileStream);

            Navigation.NavigateTo($"imports/{accepted.BatchId}");
        }
        catch (ApiException exception)
        {
            uploadError = exception.Message;
        }
        catch (IOException)
        {
            uploadError = "The file could not be read from your browser. Choose it again and retry.";
        }
        finally
        {
            isUploading = false;
        }
    }
}
